    {
      "name": "06 403 rol Veterinario no crea propietario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenVeterinario}}",
            "type": "text"
          }
        ],
        "url": "{{gateway}}/gateway/propietarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba Video\",\n  \"dni\": \"{{dni}}\",\n  \"telefono\": \"900111222\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 201 crear propietario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenRecepcionista}}",
            "type": "text"
          }
        ],
        "url": "{{gateway}}/gateway/propietarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba Video\",\n  \"dni\": \"{{dni}}\",\n  \"telefono\": \"900111222\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"dni\", String(Math.floor(90000000 + Math.random() * 9999999)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"propietarioId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 204 actualizar propietario",
      "request": {
        "method": "PUT",
