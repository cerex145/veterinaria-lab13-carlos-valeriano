        "url": "{{gateway}}/gateway/propietarios/{{propietarioId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba Video Actualizada\",\n  \"dni\": \"{{dni}}\",\n  \"telefono\": \"900111222\"\n}",
