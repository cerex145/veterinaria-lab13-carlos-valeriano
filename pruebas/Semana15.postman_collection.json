{
  "info": {
    "name": "Veterinaria Semana 15",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Login Recepcionista",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{gateway}}/gateway/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"recepcionista@veterinaria.test\",\n  \"clave\": \"{{claveRecepcionista}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"tokenRecepcionista\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login Veterinario",
      "request": {
        "method": "POST",
        "header": [],
